# 이 파일을 복사해서 .env로 저장하고 실제 값을 채워넣으세요. .env는 git에 올라가지 않습니다.
#   cp .env.example .env   (Windows: copy .env.example .env)

# 로컬 개발 기준 프론트엔드 주소 (배포 시 실제 도메인으로 변경)
FRONTEND_BASE_URL=http://localhost:5173

# 카카오/구글 로그인 없이도 게스트로 모든 기능을 쓸 수 있으므로, 아래 4개는 비워둬도
# 앱 자체는 정상 동작합니다(소셜 로그인 버튼만 비활성화됨).

# 카카오 개발자(developers.kakao.com) > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 개발자 > 보안 > Client Secret
KAKAO_CLIENT_SECRET=

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google AI Studio(aistudio.google.com) > Get API key
# 비워두면 LLM(NLU 구조화, 형광펜 근거 매칭 등) 관련 기능이 자동으로 규칙 기반 폴백으로 동작합니다.
GEMINI_API_KEY=

# CORS 허용 origin (콤마 구분). 배포 시 실제 프론트 도메인으로 바꾸세요.
# 비워두면 FRONTEND_BASE_URL + 로컬 개발 포트(5173/5183)가 기본값으로 허용됩니다.
CORS_ORIGINS=
